# Klarify zero-retention (default true — no health data on disk)
KLARIFY_ZERO_RETENTION=true
KLARIFY_DISABLE_CHROMA=false

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# Translation: auto | gemini | offline | online
TRANSLATION_MODE=auto

# E-Rezept Fachdienst: mock (demo) or live (real TI)
ERP_MODE=mock
ERP_BASE_URL=https://erp.app.ti-dienste.de
ERP_ACCESS_TOKEN=
ERP_MOCK_TOKEN=demo-bearer-token

# ePA FHIR: mock | hapi | titus
EPA_MODE=mock
EPA_FHIR_BASE_URL=http://localhost:8080/fhir
EPA_TITUS_URL=https://epa.ms.gematik-sandbox.de/fhir
EPA_OAUTH_URL=https://idp.gematik-sandbox.de/oauth2
EPA_CLIENT_ID=
EPA_CLIENT_SECRET=
