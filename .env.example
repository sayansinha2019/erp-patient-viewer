# Klarify zero-retention (default true — no health data on disk)
KLARIFY_ZERO_RETENTION=true
KLARIFY_DISABLE_CHROMA=false

# Gemini — option A (preferred): Vertex AI with a service account
#   Paste the whole service-account JSON on ONE line, wrapped in single quotes.
GCP_PROJECT_ID=
GCP_LOCATION=global
GCP_SERVICE_ACCOUNT_KEY=
# Gemini — option B: AI Studio key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Storage locations (defaults: ./.data and ./.cache next to the app)
# KLARIFY_DATA_DIR=/app/.data
# KLARIFY_CACHE_DIR=/app/.cache
# Clinical search: ChromaDB vector store; embeddings come from
#   local  = model inside the app (PRODUCTION — data stays in-house)
#   vertex = Google Vertex AI embeddings (DEMO ONLY — query text goes to Google)
KLARIFY_EMBEDDINGS=local
# KLARIFY_EMBED_MODEL=gemini-embedding-001

# Translation: auto | gemini | offline | online
TRANSLATION_MODE=auto

# E-Rezept Fachdienst: mock (demo) or live (real TI)
ERP_MODE=mock
ERP_BASE_URL=https://erp.app.ti-dienste.de
ERP_ACCESS_TOKEN=
ERP_MOCK_TOKEN=demo-bearer-token

# ePA FHIR: mock | hapi | titus
EPA_MODE=mock
EPA_FHIR_BASE_URL=http://localhost:8080/fhir
EPA_TITUS_URL=https://epa.ms.gematik-sandbox.de/fhir
EPA_OAUTH_URL=https://idp.gematik-sandbox.de/oauth2
EPA_CLIENT_ID=
EPA_CLIENT_SECRET=
